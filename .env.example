# Charupi-Api Server Configuration
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# Database Configuration (SQLite with WAL & Vector extensions)
DATABASE_URL=sqlite://data/charupi.db?mode=rwc
DATABASE_MAX_CONNECTIONS=16
DATABASE_MIN_CONNECTIONS=2

# OmniRoute LLM Gateway Configuration
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_DEFAULT_MODEL=gpt-4o-mini
OMNIROUTE_EMBEDDING_MODEL=text-embedding-3-small
OMNIROUTE_TIMEOUT_SECS=120

# Memory & Vector Search (RAG)
VECTOR_DIMENSION=768
VECTOR_TOP_K=5
VECTOR_COSINE_THRESHOLD=0.55

# Logging & Telemetry
RUST_LOG=charupi_api=debug,tower_http=info,sqlx=warn
RUST_BACKTRACE=1
